# Copy to .env in the directory where you run cpi-minimal.
# Real .env files contain plaintext secrets and are ignored by version control.
# Use only a provider endpoint you trust. It receives the API key.

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Set your DeepSeek API key in the local .env, never in this template.
OPENAI_API_KEY=

# Optional bounded provider retries. Retries count attempts after the first.
# CPI_PROVIDER_RETRIES=3
# CPI_PROVIDER_RETRY_DELAY_MS=250
# CPI_PROVIDER_RETRY_MAX_DELAY_MS=4000
