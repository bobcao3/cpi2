{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"files": {
		"includes": [
			"**/*.md",
			"**/*.markdown",
			"!!**/.git",
			"!!**/.jj",
			"!!**/node_modules",
			"!!**/.zig-cache",
			"!!**/zig-out",
			"!!**/zig-pkg"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"markdown": {
		"formatter": {
			"enabled": true,
			"lineWidth": 80,
			"proseWrap": "always",
			"formatEmbeds": false
		}
	}
}
